# Copy this file to .env and fill in a new key generated from your API provider.
# Never commit .env or paste real API keys into source files.

# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value unchanged across deployments so saved PDF/Excel AI keys remain decryptable.
PDF_EXCEL_AI_CONFIG_MASTER_KEY=

# Legacy fallback used until the first web-managed PDF/Excel AI version is activated.
PDF_EXCEL_AI_REPAIR_ENABLED=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
PDF_EXCEL_AI_REPAIR_TIMEOUT_SECONDS=45
PDF_EXCEL_AI_REPAIR_MAX_ROWS=12
