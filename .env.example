# Copy this file to .env and fill in a new key generated from your API provider.
# Never commit .env or paste real API keys into source files.

# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value unchanged across deployments so saved PDF/Excel AI keys remain decryptable.
PDF_EXCEL_AI_CONFIG_MASTER_KEY=

# Legacy fallback used until the first web-managed PDF/Excel AI version is activated.
PDF_EXCEL_AI_REPAIR_ENABLED=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
PDF_EXCEL_AI_REPAIR_TIMEOUT_SECONDS=45
PDF_EXCEL_AI_REPAIR_MAX_ROWS=12
# Order-mail automation database. The application remains on SQLite unless
# AUTOMATION_DATABASE_BACKEND is explicitly changed after formal approval.
AUTOMATION_DATABASE_BACKEND=sqlite
AUTOMATION_POSTGRESQL_READ_WRITE_ENABLED=false
AUTOMATION_DATABASE_URL=
AUTOMATION_TEST_DATABASE_URL=
AUTOMATION_SHADOW_DATABASE_URL=
AUTOMATION_OUTBOX_BATCH_SIZE=100
AUTOMATION_OUTBOX_POLL_SECONDS=5
AUTOMATION_CUTOVER_DATABASE_URL=
AUTOMATION_ROLLBACK_DATABASE_URL=
AUTOMATION_OBSERVATION_DATABASE_URL=
AUTOMATION_DB_POOL_MIN_SIZE=1
AUTOMATION_DB_POOL_MAX_SIZE=8
AUTOMATION_DB_CONNECT_TIMEOUT_SECONDS=10
AUTOMATION_DB_STATEMENT_TIMEOUT_MS=30000

# User/login database. Keep SQLite until the users table has been copied,
# verified and an explicit identity cutover has been approved.
IDENTITY_DATABASE_BACKEND=sqlite
IDENTITY_POSTGRESQL_READ_WRITE_ENABLED=false
IDENTITY_DATABASE_URL=
IDENTITY_TEST_DATABASE_URL=
IDENTITY_DB_POOL_MIN_SIZE=1
IDENTITY_DB_POOL_MAX_SIZE=4
IDENTITY_DB_CONNECT_TIMEOUT_SECONDS=10
IDENTITY_DB_STATEMENT_TIMEOUT_MS=30000

# Shared jobs, PP transcode and general transcode rule/runtime tables.
TRANSCODE_DATABASE_BACKEND=sqlite
TRANSCODE_POSTGRESQL_READ_WRITE_ENABLED=false
TRANSCODE_DATABASE_URL=
TRANSCODE_TEST_DATABASE_URL=
TRANSCODE_DB_POOL_MIN_SIZE=1
TRANSCODE_DB_POOL_MAX_SIZE=8
TRANSCODE_DB_CONNECT_TIMEOUT_SECONDS=10
TRANSCODE_DB_STATEMENT_TIMEOUT_MS=30000
TRANSCODE_MIGRATION_LOG_PATH=

# Global settings and PDF-to-Excel AI configuration versions.
CONFIG_DATABASE_BACKEND=sqlite
CONFIG_POSTGRESQL_READ_WRITE_ENABLED=false
CONFIG_DATABASE_URL=
CONFIG_TEST_DATABASE_URL=
CONFIG_DB_POOL_MIN_SIZE=1
CONFIG_DB_POOL_MAX_SIZE=4
CONFIG_DB_CONNECT_TIMEOUT_SECONDS=10
CONFIG_DB_STATEMENT_TIMEOUT_MS=30000
CONFIG_MIGRATION_LOG_PATH=

# Work planning categories/tasks and user feedback.
PLANNING_DATABASE_BACKEND=sqlite
PLANNING_POSTGRESQL_READ_WRITE_ENABLED=false
PLANNING_DATABASE_URL=
PLANNING_TEST_DATABASE_URL=
PLANNING_DB_POOL_MIN_SIZE=1
PLANNING_DB_POOL_MAX_SIZE=4
PLANNING_DB_CONNECT_TIMEOUT_SECONDS=10
PLANNING_DB_STATEMENT_TIMEOUT_MS=30000
PLANNING_MIGRATION_LOG_PATH=

# Stage-one file reads prefer this managed root and fall back to legacy paths.
AUTOMATION_FILE_STORAGE_ROOT=storage/automation_objects
