# Runtime data: never commit local or production state.
/storage/
config/model.local.yaml
.env
.env.local
.env.*.local
config/local.env
config/model.local.yaml

# Python cache and local virtual environments.
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Local server logs and generated runtime output.
/outputs/
*.log
*.out
*.err
local_server_*latest.log
server_stdout.log
server_stderr.log
workplan_server_*.log

# Local-only test suites.
/tests_*/

# Local backups and temporary merge artifacts.
*.bak
*.bak_*
*.bak-*
*.tmp
*.temp
~$*
.~*

# OS/editor metadata.
.DS_Store
Thumbs.db
.idea/
.vscode/

# Release bundles kept outside source control.
/nanya_platform_*.zip
/nanya_platform_*.tar.gz
